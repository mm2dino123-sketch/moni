local Players=game:GetService("Players")
local TweenService=game:GetService("TweenService")
local RunService=game:GetService("RunService")
local LocalPlayer=Players.LocalPlayer

_G.lagging=false
_G.lagFolder=nil

-- Server lag function (doesn't affect you)
_G.monisLag=function()
    if _G.lagging then return end
    _G.lagging=true
    _G.lagFolder=Instance.new("Folder",workspace)
    _G.lagFolder.Name="MonisLag"
    
    spawn(function()
        while _G.lagging do
            for i=1,150 do
                local p=Instance.new("Part")
                p.Name="LagPart"
                p.Size=Vector3.new(0.2,0.2,0.2)
                p.Material=Enum.Material.Neon
                p.BrickColor=BrickColor.Random()
                p.CanCollide=true
                p.Anchored=false
                p.Position=Vector3.new(math.random(-1000,1000),math.random(50,500),math.random(-1000,1000))
                p.Parent=_G.lagFolder
                
                -- Spam physics
                TweenService:Create(p,TweenInfo.new(0.05),{Size=Vector3.new(5,5,5)}):Play()
                TweenService:Create(p,TweenInfo.new(0.1),{CFrame=p.CFrame* CFrame.Angles(0,math.rad(360),0)}):Play()
            end
            
            -- Remote spam (server strain)
            for _,v in pairs(Players:GetPlayers()) do
                if v~=LocalPlayer and v.Character then
                    pcall(function()
                        game.ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer("LAGGING BY MONIS","All")
                    end)
                end
            end
            
            wait(0.008)
        end
    end)
end

_G.stopMonisLag=function()
    _G.lagging=false
    if _G.lagFolder then
        _G.lagFolder:Destroy()
        _G.lagFolder=nil
    end
end


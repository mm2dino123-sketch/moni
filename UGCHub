    btn.Position = UDim2.new(0, 14, 0, y)
    btn.BackgroundColor3 = isOutline and BG_DARK or WHITE
    btn.TextColor3 = isOutline and OFF_WHITE or BG_DARK
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.Text = btnText
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    if isOutline then
        local stroke = Instance.new("UIStroke", btn)
        stroke.Color = Color3.fromRGB(55, 55, 55)
        stroke.Thickness = 1.2
    end

    btn.MouseEnter:Connect(function()
        if isOutline then
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = DARK_GRAY}):Play()
        else
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = OFF_WHITE}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        local activeCol = btn:GetAttribute("ActiveColor")
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = activeCol or (isOutline and BG_DARK or WHITE)}):Play()
    end)

    return btn
end

